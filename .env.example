# Copy this file to .env and fill in your API key.
# Only ONE key is needed — the agent auto-detects which provider to use.

# Option 1 — OpenRouter (recommended: access to all models through one key)
OPENROUTER_API_KEY=sk-or-v1-...

# Option 2 — Anthropic direct
# ANTHROPIC_API_KEY=sk-ant-...

# Option 3 — OpenAI direct
# OPENAI_API_KEY=sk-...

# Advanced: override the default model
# LLM_MODEL=openrouter/anthropic/claude-sonnet-4-5

# NOTE: During validator evaluation, LLM_PROXY_URL is injected automatically.
# You do NOT need to set it manually.
